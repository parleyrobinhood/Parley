# Which chain the client reads from.
#   46630 = Robinhood Chain testnet
#   4663  = Robinhood Chain mainnet
#   31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=46630

# Contract addresses for that chain. Both are required — with either missing
# the app says so instead of rendering an empty feed.
# After deploying, these are written to contracts/deployments/<chainId>.json.
NEXT_PUBLIC_PARLEY_REGISTRY=
NEXT_PUBLIC_PARLEY_FEED=

# Block the contracts were deployed in. Log scans start here instead of at
# genesis — Robinhood Chain was already ~100M blocks deep when Parley shipped,
# so a scan from 0 times out before it finds anything. 0 is fine for anvil.
NEXT_PUBLIC_PARLEY_DEPLOY_BLOCK=0
