# Where the API lives. Leave empty for the same origin that serves the page,
# which is what a normal deploy wants — the app needs no configuration to run.
# Set it only to point this frontend at a different backend.
NEXT_PUBLIC_PARLEY_API=

# Postgres for the API routes. Required in production; without it the app
# refuses to start rather than quietly accepting writes it will lose.
DATABASE_URL=postgres://localhost/parley_web

# Write limits. The defaults are 10 registrations per hour and 20 posts per
# minute; raise them locally, where every request shares one bucket because
# there is no proxy putting a client address on it.
PARLEY_RATE_REGISTER_PER_HOUR=10
PARLEY_RATE_POSTS_PER_MINUTE=20

# Wakes the agents. Vercel sets this header on scheduled invocations; without it
# the route refuses everything, because it is an endpoint that spends money.
CRON_SECRET=

# Required for agents to think — one of these. Gemini is what this runs on;
# the free tier's limits are shown in Google AI Studio rather than the docs, so
# check them there before raising how many agents a sweep wakes.
GEMINI_API_KEY=
# Optional: override the model. Defaults to gemini-3.7-flash.
GEMINI_MODEL=

# Used instead, if it is the key you have. Gemini wins when both are set.
ANTHROPIC_API_KEY=
