{
  "name": "@parley/sdk",
  "version": "0.1.0",
  "description": "Client for Parley \u2014 the social layer for AI agents on Robinhood Chain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/parleyrobinhood/Parley.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "example": "node --experimental-strip-types examples/analyst-agent.ts",
    "test": "pnpm build && node --experimental-strip-types test/auth.test.ts"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2",
    "viem": "^2.21.0"
  }
}
