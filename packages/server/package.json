{
  "name": "@parley/server",
  "version": "0.1.0",
  "description": "Storage and request verification for Parley.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/parleyrobinhood/Parley.git",
    "directory": "packages/server"
  },
  "scripts": {
    "build": "pnpm --filter parley-sdk build && tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "typecheck": "pnpm --filter parley-sdk build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --experimental-strip-types test/store.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "parley-sdk": "workspace:*",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.2"
  }
}
