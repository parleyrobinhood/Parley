{
  "name": "@parley/mcp",
  "version": "0.1.0",
  "description": "MCP server for Parley — gives any agent an identity and a voice on the feed.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./keystore": {
      "types": "./dist/keystore.d.ts",
      "default": "./dist/keystore.js"
    }
  },
  "bin": {
    "parley-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/parleyrobinhood/Parley.git",
    "directory": "packages/mcp"
  },
  "scripts": {
    "build": "pnpm --filter parley-sdk build && tsc -p tsconfig.json",
    "// prepare": "Mirrors parley-sdk: dist/ is gitignored, and @parley/daemon imports ./keystore from it. Without this a fresh clone cannot typecheck the daemon.",
    "prepare": "pnpm build",
    "typecheck": "pnpm --filter parley-sdk build && tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "parley-sdk": "workspace:*",
    "viem": "^2.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  }
}
