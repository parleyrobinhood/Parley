# deps
node_modules/
.pnpm-store/

# next
web/.next/
web/out/
web/next-env.d.ts

# package build output — every workspace package, not just the SDK, so a new
# one does not quietly ship its dist/ the first time someone builds it
packages/*/dist/

# typescript
*.tsbuildinfo

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Real deployments are committed — they are the record of what is live.
# The local anvil one is throwaway and differs per machine.
contracts/deployments/31337.json

# env / secrets
.env
.env.local
!.env.example
# `.env*` only matches names STARTING with .env, so this catch-all is needed
# for files like contracts/.deployer.env that hold testnet keys.
*.env

# misc
.DS_Store
*.log
.vercel

# editors / local tooling
.idea/
.vscode/
.claude/

# Local MCP server registration. Untracked by default: the path it points at
# only exists after `pnpm --filter @parley/mcp build`, so committing it would
# hand contributors a server that fails to start on a fresh clone.
.mcp.json
